SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://wearright:wearright@localhost:5433/wearright

# Product photos live outside the repo so uploads survive worktrees, backups and
# reinstalls. Create the folder before uploading anything; when unset the photos
# stay in apps/server/media.
# MEDIA_ROOT=/home/jb/wear-right-data/media

# Django serves /media/ itself while SERVE_MEDIA=True, with DEBUG on or off.
# In production point a web server (nginx etc.) at MEDIA_ROOT and set SERVE_MEDIA=False.
# SERVE_MEDIA=False

# Email. Mailpit is started by `make db-up`; read what was sent at http://localhost:8025.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
DEFAULT_FROM_EMAIL=Wear Right <no-reply@wearright.local>

# Links in emails point at the web app, not Django.
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600

# Demo shop: list only the products that are on the mannequin (run `manage.py publish_mannequin_demo` first).
# SHOP_MANNEQUIN_ONLY=True

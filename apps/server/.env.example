# Wear Right Django Backend - Environment Variables Template
# Copy this file to .env and configure values for your environment.

# Django Security Key (generate a random 50+ character string for production)
SECRET_KEY=django-insecure-fyp-secret-key-wear-right-2026

# Debug mode: True for development, False for production
DEBUG=True

# Comma-separated list of hostnames/IPs this Django app can serve
# Examples: localhost,127.0.0.1,.onrender.com,.railway.app
ALLOWED_HOSTS=*

# -----------------------------------------------------------------------------
# Database Configuration
# -----------------------------------------------------------------------------
# Option 1: SQLite (Easiest for local dev - creates a portable db.sqlite3 file)
USE_SQLITE=True

# Option 2: Cloud / Managed PostgreSQL URL (Preferred for demo production)
# DATABASE_URL=postgres://user:password@host:5432/dbname?sslmode=require

# Option 3: Traditional PostgreSQL credentials
# DB_ENGINE=postgresql
# DB_NAME=wear_right_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# -----------------------------------------------------------------------------
# CORS & CSRF Configuration
# -----------------------------------------------------------------------------
# Comma-separated list of client domains allowed to make API requests
# In production, must include your Vercel deployment URL
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,https://wear-right.vercel.app

# Comma-separated list of origins trusted for CSRF protection
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,https://wear-right.vercel.app

# Set to True if you want to allow all origins in a temporary testing demo
CORS_ALLOW_ALL_ORIGINS=False


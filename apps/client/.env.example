# Wear Right Client - Example Environment Variables
# Copy this file to .env or set these in your Vercel Project Settings -> Environment Variables

# Base URL pointing to the running Django backend (no trailing slash)
# Local: http://127.0.0.1:8000
# Production: https://your-backend-service.onrender.com (or Railway/fly.io)
VITE_API_URL=http://127.0.0.1:8000

# WhatsApp business/admin contact number for checkout and inquiry links (with country code, no + or spaces)
VITE_ADMIN_WHATSAPP_NUMBER=923021191771

